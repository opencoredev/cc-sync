{
  "name": "cc-sync",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "convex": "^1.33.1",
      "better-auth": "~1.6.9",
      "@convex-dev/better-auth": "^0.12.2",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo -F web -F fumadocs -F @cc-sync/backend dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "cli": "bun run --cwd apps/cli src/index.ts",
    "cli:build": "bun run --cwd apps/cli build",
    "test": "turbo test",
    "dev:web": "turbo -F web dev",
    "dev:docs": "turbo -F fumadocs dev",
    "dev:server": "turbo -F @cc-sync/backend dev",
    "dev:setup": "turbo -F @cc-sync/backend dev:setup",
    "ports": "portless list",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@cc-sync/env": "workspace:*",
    "convex": "^1.39.1",
    "dotenv": "catalog:",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cc-sync/config": "workspace:*",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "portless": "^0.13.1",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "packageManager": "bun@1.3.14"
}
